{
  "name": "@amenophis1er/claude-voice",
  "version": "0.2.0",
  "publishConfig": { "access": "public" },
  "description": "Give Claude Code a voice — selective, tasteful spoken summaries and attention cues. Quiet by default.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amenophis1er/claude-voice.git"
  },
  "homepage": "https://github.com/amenophis1er/claude-voice#readme",
  "type": "module",
  "bin": {
    "claude-voice": "dist/cli.js"
  },
  "files": ["dist", "hooks", ".claude-plugin", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "init": "node src/cli.ts init",
    "hooks:install": "node src/cli.ts install",
    "hooks:uninstall": "node src/cli.ts uninstall",
    "list": "node src/cli.ts list",
    "voices": "node src/cli.ts voices",
    "config": "node src/cli.ts config",
    "say": "node src/cli.ts test",
    "test": "node test/verify.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["claude-code", "tts", "voice", "hooks", "plugin"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
